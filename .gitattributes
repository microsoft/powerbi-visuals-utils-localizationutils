# Normalize line endings ONLY for files that participate in the daily
# loc-PR feedback loop between:
#   1) .github/workflows/harvest-en-strings.yml and distribute-translations.yml
#      (Ubuntu, write LF)
#   2) .pipelines/pipeline.localization.utils.yml (Windows + OneLocBuild, writes CRLF)
#
# Without this, the two pipelines re-flip each other's line endings every day
# and open a "New translations" PR with no real content changes.
#
# LF chosen because the upstream source of truth (each visual's submodule
# stringResources/en-US/resources.resjson) is LF, and 3 of the 4 writers
# already produce LF.
#
# Note that `git add` normalizes into the INDEX only - the working copy keeps
# whatever the writer produced. Anything that commits must therefore upload the
# staged blob rather than the file on disk, or it silently re-commits CRLF and
# produces empty commits (see src/commit-and-open-pr.js).

localizations/**/*.resjson text eol=lf

# OneLocBuild writes these on the Windows agent and commits them from its own `locfiles`
# PR, so without this every run flips all of them between CRLF and LF.
src/loc/**/*.lcl text eol=lf
